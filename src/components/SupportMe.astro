---
const BMC_URL = "https://buymeacoffee.com/subodhka";
---

<section id="support" class="section">
    <div class="container">
        <div class="support-card">
            <div class="support-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                    <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z"/>
                    <line x1="6" y1="2" x2="6" y2="4"/>
                    <line x1="10" y1="2" x2="10" y2="4"/>
                    <line x1="14" y1="2" x2="14" y2="4"/>
                </svg>
            </div>
            <h2>Enjoying what you see?</h2>
            <p class="support-copy">
                This site and everything in the infrastructure section above runs on a server
                I pay for out of pocket. If any of it has been useful to you, a coffee helps
                keep the lights on.
            </p>
            <a href={BMC_URL} target="_blank" rel="noopener noreferrer" class="support-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                    <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z"/>
                </svg>
                Buy me a coffee
            </a>
        </div>
    </div>
</section>

<style>
    .support-card {
        max-width: 620px;
        margin: 0 auto;
        text-align: center;
        background: var(--card-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 1rem;
        padding: 3rem 2rem;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .support-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffdd00, #ffb300);
        color: #1f2937;
    }

    h2 {
        font-size: 1.85rem;
        margin: 0 0 0.75rem 0;
        color: var(--text);
    }

    .support-copy {
        font-size: 1rem;
        line-height: 1.65;
        color: var(--text);
        opacity: 0.8;
        margin: 0 0 1.75rem 0;
    }

    .support-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1.75rem;
        background: #ffdd00;
        color: #1f2937;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(255, 221, 0, 0.3);
    }

    .support-btn svg {
        color: #1f2937;
    }

    .support-btn:hover {
        background: #ffe94d;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255, 221, 0, 0.4);
    }

    @media (max-width: 640px) {
        .support-card {
            padding: 2.5rem 1.5rem;
        }

        h2 {
            font-size: 1.5rem;
        }
    }
</style>
