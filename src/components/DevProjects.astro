---
const projects = [
    {
        title: "Fishbone RCA Analyzer",
        emoji: "🐟",
        description: "Streamlit app for incident post-mortems using Ishikawa fishbone diagrams and the 6M framework. Real-time SVG diagrams, pre-built DevOps templates, multi-format exports.",
        tech: "Python · Streamlit · SVG · Markdown",
        github: "https://github.com/tusuii/ishikawa-RCA",
        live: "https://ishikawa-rca-subodh-devops-project.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/ishikawa-RCA",
    },
    {
        title: "SRE Metrics Calculator",
        emoji: "📊",
        description: "Production-grade incident metrics dashboard featuring MTTD, MTTR, MTTF, MTBF calculations with SLA compliance tracking, trend analysis, and Gantt-style timeline visualization.",
        tech: "Python · Streamlit · SQLite · Pandas",
        github: "https://github.com/tusuii/SRE-metrices-calculator",
        live: "https://sre-metrices-calculator.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/SRE-metrices-calculator",
    },
    {
        title: "Jenkins Visualizer & Debugger",
        emoji: "🔧",
        description: "Interactive interface to map pipeline flows, pinpoint failures instantly, and visualize resource usage in real-time. Built for DevOps engineers debugging CI/CD.",
        tech: "Python · Streamlit",
        github: "https://github.com/tusuii/jenkins-visualizer-debugger",
        live: "https://jenkins-visualizer.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/jenkins-visualizer-debugger",
    },
    {
        title: "Chaos Theory Simulation",
        emoji: "🌀",
        description: "Explore deterministic systems that appear random, with interactive visualizations of strange attractors, bifurcation diagrams, and sensitivity to initial conditions.",
        tech: "Python · CSS",
        github: "https://github.com/tusuii/chaos-theory-simulation",
        live: "https://chaos-theory-simulation.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/chaos-theory-simulation",
    },
    {
        title: "Monte Carlo Playground",
        emoji: "🎲",
        description: "Interactive playground to prove algorithms and concepts using Monte Carlo methods: probability simulations, numerical integration, and stochastic modeling.",
        tech: "Python",
        github: "https://github.com/tusuii/monte-carlo-playground",
        live: "https://monte-carlo-playground.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/monte-carlo-playground",
    },
    {
        title: "Music Lab",
        emoji: "🎵",
        description: "A scientific approach to sound: manipulate frequencies, audio parameters, and sound transformations through a laboratory-style workspace for audio experimentation.",
        tech: "Python · Flask · CSS",
        github: "https://github.com/tusuii/Music-lab",
        live: "https://music-lab.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/Music-lab",
    },
    {
        title: "Chymistry",
        emoji: "⚗️",
        description: "An element-merging game where you combine basic building blocks of the universe to unlock hundreds of unique items, from simple reactions to cosmic phenomena.",
        tech: "Python",
        github: "https://github.com/tusuii/chymistery",
        live: "https://chymistery.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/chymistery",
    },
    {
        title: "Algorithms Showdown",
        emoji: "⚔️",
        description: "Visual algorithm comparisons where sorting, searching, and graph algorithms compete side-by-side with real-time animated visualizations.",
        tech: "Python",
        github: "https://github.com/tusuii/algorithms-showdown",
        live: "https://algorithms-showdown.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/algorithms-showdown",
    },
    {
        title: "Decision Theory Simulation",
        emoji: "🎯",
        description: "Bridge the gap between raw probability and actionable strategy by simulating complex decision scenarios under uncertainty with interactive tools.",
        tech: "Python · Streamlit · CSS",
        github: "https://github.com/tusuii/probablity-decession-theory-simulation",
        live: "https://probablity-decession-theory-simulation.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/probablity-decession-theory-simulation",
    },
    {
        title: "Catalan Zoo",
        emoji: "🐱",
        description: "A zoo of Catalan numbers, exploring hundreds of combinatorial objects counted by this fascinating mathematical sequence through interactive exhibits.",
        tech: "Python · CSS",
        github: "https://github.com/tusuii/catalan-zoo",
        live: "https://catalan-zoo.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/catalan-zoo",
    },
    {
        title: "Combinatorial Game Theory",
        emoji: "🎮",
        description: "Simulate combinatorial game theory scenarios with an interactive Streamlit app covering Nim, Hackenbush, and other mathematical games.",
        tech: "Python · Streamlit · CSS",
        github: "https://github.com/tusuii/CGT",
        live: "https://com-game-theory.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/CGT",
    },
    {
        title: "L-System Visualization",
        emoji: "🌿",
        description: "Visualize Lindenmayer systems that generate fractal patterns and biological growth models through recursive string rewriting and turtle graphics.",
        tech: "Python",
        github: "https://github.com/tusuii/ltree-visualization",
        live: "https://ltree-visualization.streamlit.app/",
        image: "https://opengraph.githubassets.com/1/tusuii/ltree-visualization",
    },
];

const projectsWithTags = projects.map((project) => ({
    ...project,
    tags: project.tech.split("·").map((t) => t.trim()),
}));

const tagCounts = new Map<string, number>();
projectsWithTags.forEach((project) => {
    project.tags.forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
});

const filterTags = Array.from(tagCounts.entries())
    .filter(([, count]) => count > 1)
    .sort((a, b) => b[1] - a[1])
    .map(([tag]) => tag);

const SPLINE_URL = "https://my.spline.design/wizardroomcopy-9IGUhSGPKjKCaCtrY3qDU5z1/";
---

<section id="dev-projects" class="section">
    <div class="container">
        <h2>Developer Projects</h2>
        <p class="section-description">Python apps I build for fun: simulations, visualizers, and developer tools</p>

        <div class="spline-wrapper" id="spline-wrapper" data-src={SPLINE_URL}>
            <div class="spline-skeleton" id="spline-skeleton">
                <div class="skeleton-shimmer" aria-hidden="true"></div>
                <div class="skeleton-fallback" id="spline-fallback" hidden>
                    <span class="skeleton-icon" aria-hidden="true">✨</span>
                    <p>Interactive 3D scene</p>
                    <a href={SPLINE_URL} target="_blank" rel="noopener noreferrer">Open in new tab</a>
                </div>
            </div>
        </div>

        <div class="project-filters" role="group" aria-label="Filter projects by technology">
            <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">All</button>
            {filterTags.map((tag) => (
                <button type="button" class="filter-btn" data-filter={tag} aria-pressed="false">{tag}</button>
            ))}
        </div>

        <div class="dev-grid" id="dev-grid">
            {projectsWithTags.map((project) => (
                <div class="dev-card card" data-tags={project.tags.join("|")}>
                    <a href={project.live || project.github} target="_blank" rel="noopener noreferrer" class="card-image-link">
                        <div class="card-image">
                            <img src={project.image} alt={project.title} loading="lazy" />
                        </div>
                    </a>
                    <div class="card-content">
                        <h4>{project.emoji} {project.title}</h4>
                        <p class="dev-tech">{project.tech}</p>
                        <p class="dev-desc">{project.description}</p>
                        <div class="card-links">
                            <a href={project.github} target="_blank" rel="noopener noreferrer" class="link-btn github-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                                Code
                            </a>
                            {project.live && (
                                <a href={project.live} target="_blank" rel="noopener noreferrer" class="link-btn live-btn">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                    Live Demo
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            ))}
        </div>
        <p class="no-results" id="no-results" role="status" aria-live="polite" hidden>No projects match this filter.</p>
    </div>
</section>

<style>
    h2 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        text-align: center;
        color: var(--text);
    }

    .section-description {
        text-align: center;
        color: var(--text);
        opacity: 0.7;
        font-size: 1.1rem;
        margin-bottom: 2.5rem;
    }

    .spline-wrapper {
        position: relative;
        height: 400px;
        border-radius: 1rem;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        border: 1px solid rgba(var(--accent-rgb), 0.15);
        background: linear-gradient(135deg, var(--gradient-1), var(--gradient-2));
    }

    .spline-wrapper iframe {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .spline-wrapper iframe.is-loaded {
        opacity: 1;
    }

    .spline-skeleton {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        transition: opacity 0.3s ease;
    }

    .spline-skeleton.is-hidden {
        opacity: 0;
        pointer-events: none;
    }

    .skeleton-shimmer {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            100deg,
            transparent 30%,
            rgba(var(--accent-rgb), 0.12) 50%,
            transparent 70%
        );
        background-size: 200% 100%;
        animation: shimmer 1.8s ease-in-out infinite;
    }

    @keyframes shimmer {
        0% { background-position: 150% 0; }
        100% { background-position: -50% 0; }
    }

    .skeleton-fallback {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-align: center;
        color: var(--text);
    }

    .skeleton-icon {
        font-size: 2rem;
    }

    .skeleton-fallback p {
        margin: 0;
        opacity: 0.75;
        font-size: 0.95rem;
    }

    .skeleton-fallback a {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .skeleton-fallback a:hover {
        text-decoration: underline;
    }

    @media (prefers-reduced-motion: reduce) {
        .skeleton-shimmer {
            animation: none;
        }
    }

    .project-filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 2.5rem;
    }

    .filter-btn {
        padding: 0.4rem 1rem;
        border-radius: 999px;
        border: 1.5px solid rgba(var(--accent-rgb), 0.25);
        background: var(--card-bg);
        color: var(--text);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .filter-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .filter-btn.is-active {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
    }

    .no-results {
        text-align: center;
        color: var(--text);
        opacity: 0.7;
        padding: 2rem 0;
    }

    .dev-card.is-filtered-out {
        display: none;
    }

    .dev-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 2rem;
    }

    .dev-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 0;
        border-radius: 0.5rem;
    }

    .dev-card:hover {
        transform: translateY(-2px);
    }

    .card-image-link {
        display: block;
        text-decoration: none;
    }

    .card-image {
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: linear-gradient(135deg, var(--gradient-1), var(--gradient-2));
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .dev-card:hover .card-image img {
        transform: scale(1.05);
    }

    .card-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-content h4 {
        font-size: 1.35rem;
        margin: 0 0 0.4rem 0;
        color: var(--accent);
    }

    .dev-tech {
        font-size: 0.8rem;
        color: var(--accent);
        opacity: 0.85;
        margin: 0 0 1rem 0;
        line-height: 1.5;
    }

    .dev-desc {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text);
        opacity: 0.8;
        margin: 0 0 1.25rem 0;
        flex: 1;
    }

    .card-links {
        display: flex;
        gap: 0.75rem;
        margin-top: auto;
    }

    .link-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        border-radius: 0.375rem;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .github-btn {
        background: var(--text);
        color: white;
    }

    .github-btn:hover {
        background: #000;
        transform: translateY(-1px);
    }

    .live-btn {
        background: var(--accent);
        color: white;
    }

    .live-btn:hover {
        background: var(--accent-light);
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .dev-grid {
            grid-template-columns: 1fr;
        }

        .spline-wrapper {
            height: 250px;
        }
    }
</style>

<script>
    const wrapper = document.getElementById('spline-wrapper');
    const skeleton = document.getElementById('spline-skeleton');
    const fallback = document.getElementById('spline-fallback');
    const SPLINE_LOAD_TIMEOUT_MS = 9000;

    function loadSpline() {
        if (!wrapper || wrapper.dataset.loaded) return;
        wrapper.dataset.loaded = 'true';

        const src = wrapper.getAttribute('data-src');
        if (!src) return;

        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = '3D Animation';
        iframe.loading = 'lazy';
        iframe.setAttribute('frameborder', '0');

        let settled = false;
        const timeoutId = window.setTimeout(() => {
            if (settled) return;
            settled = true;
            fallback?.removeAttribute('hidden');
        }, SPLINE_LOAD_TIMEOUT_MS);

        iframe.addEventListener('load', () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timeoutId);
            iframe.classList.add('is-loaded');
            skeleton?.classList.add('is-hidden');
        });

        wrapper.appendChild(iframe);
    }

    if (wrapper) {
        if ('IntersectionObserver' in window) {
            const splineObserver = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            loadSpline();
                            splineObserver.disconnect();
                        }
                    });
                },
                { rootMargin: '200px' }
            );
            splineObserver.observe(wrapper);
        } else {
            loadSpline();
        }
    }

    // Project filtering
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('#dev-grid .dev-card'));
    const noResults = document.getElementById('no-results');

    filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
            const filter = btn.getAttribute('data-filter') || 'all';

            filterButtons.forEach((b) => {
                b.classList.toggle('is-active', b === btn);
                b.setAttribute('aria-pressed', String(b === btn));
            });

            let visibleCount = 0;
            projectCards.forEach((card) => {
                const tags = (card.getAttribute('data-tags') || '').split('|');
                const matches = filter === 'all' || tags.includes(filter);
                card.classList.toggle('is-filtered-out', !matches);
                if (matches) visibleCount++;
            });

            if (noResults) noResults.hidden = visibleCount !== 0;
        });
    });
</script>
